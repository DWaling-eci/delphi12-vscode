{
    "name": "delphi-vscode",
    "publisher": "adventune",
    "repository": {
        "type": "git",
        "url": "https://github.com/Adventune/delphi-vscode"
    },
    "displayName": "Delphi",
    "description": "Delphi support for VSCode",
    "version": "1.0.1",
    "engines": {
        "vscode": "^1.91.0"
    },
    "extensionKind": [
        "workspace"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": false,
            "description": "The extension launches DelphiLSP and generates/runs build scripts based on workspace files and settings."
        }
    },
    "categories": [
        "Programming Languages"
    ],
    "main": "./out/main",
    "contributes": {
        "languages": [
            {
                "id": "objectpascal",
                "aliases": [
                    "Delphi",
                    "pascal"
                ],
                "extensions": [
                    ".pas",
                    ".pp",
                    ".inc",
                    ".dpr",
                    ".dpk"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "objectpascal",
                "scopeName": "source.pascal",
                "path": "./syntaxes/pascal.tmLanguage"
            }
        ],
        "snippets": [
            {
                "language": "objectpascal",
                "path": "./snippets/pascal.json"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Delphi",
            "properties": {
                "delphi.bin": {
                    "type": "string",
                    "default": "",
                    "description": "Path to Delphi `bin` folder (must contain DelphiLSP.exe). Defaults to newest installation."
                },
                "delphi.serverType": {
                    "type": "string",
                    "default": "controller",
                    "enum": [
                        "controller",
                        "agent",
                        "linter"
                    ],
                    "enumDescriptions": [
                        "Mutli process mode with <agentCount> sub processes. Error Insight available when <agentCount> >= 2",
                        "Single process mode without Error Insight",
                        "Single process mode with Error Insight only; without code completion or other language features"
                    ],
                    "description": "Defines the operation mode"
                },
                "delphi.agentCount": {
                    "type": "integer",
                    "default": 2,
                    "minimum": 1,
                    "maximum": 2,
                    "description": "Defines the number of sub processes (agents) when serverType is controller. If agentCount > 1 then one process will be dedicated to Error Insight"
                },
                "delphi.logModes": {
                    "type": "integer",
                    "default": 0,
                    "description": "Bit mask defining logging modes [1 (RawInputMessage), 2 (RawOutputMessage), 4 (Queue), 8 (Processor), 16 (Server), 32 (AgentFacade), 64 (DCC related), 128 (LSP Inspector traces)]"
                },
                "delphi.configFile": {
                    "type": "string",
                    "default": "",
                    "description": "File URI of current LSP config (.delphilsp.json)"
                }
            }
        },
        "commands": [
            {
                "command": "delphi.selectConfigFile",
                "title": "Delphi: Select LSP config file"
            },
            {
                "command": "delphi.regenRunScript",
                "title": "Delphi: Regenerate run script for current project"
            },
            {
                "command": "delphi.run",
                "title": "Delphi: Run current project",
                "icon": "$(play)"
            }
        ],
        "menus": {
            "editor/title/run": [
                {
                    "when": "resourceLangId == objectpascal",
                    "command": "delphi.run",
                    "group": "navigation"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "package": "vsce package",
        "compile": "tsc -b",
        "pretty": "prettier --write ./src/**/*",
        "check:types": "tsc --noEmit",
        "check:format": "prettier --check ./src/**/*",
        "lint": "eslint src",
        "check:all": "npm run check:types && npm run check:format && npm run lint"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/mocha": "^10.0.10",
        "@types/node": "^20.19.43",
        "@types/semver": "^7.8.0",
        "@types/vscode": "~1.91.0",
        "@vscode/test-electron": "^3.1.0",
        "eslint": "^10.11.0",
        "mocha": "^12.0.3",
        "prettier": "^3.9.9",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.71.0"
    },
    "dependencies": {
        "semver": "^7.8.5",
        "vscode-languageclient": "^10.1.2"
    }
}
